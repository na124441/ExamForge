# ExamForge Production Environment Configuration Example
# Copy to .env and configure secret keys (DO NOT COMMIT REAL SECRETS TO GIT)

# Resend Transactional Email API Key
RESEND_API_KEY=re_your_production_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=ExamForge Assessment System

# India DLT Telecom SMS Gateway (MSG91)
MSG91_AUTH_KEY=your_msg91_production_auth_key
MSG91_TEMPLATE_ID=your_dlt_approved_template_id
MSG91_SENDER_ID=EXAMFG

# OTP Expiration & Rate Limiting
OTP_EXPIRY_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

OTP_MAX_REQUESTS_PER_EMAIL=5
OTP_RATE_LIMIT_WINDOW_SECONDS=900

# Database & Redis Cache
DATABASE_URL=sqlite:///./examforge.db
REDIS_URL=redis://localhost:6379/0

# Security Key
SECRET_KEY=examforge-super-secret-production-key-change-this
