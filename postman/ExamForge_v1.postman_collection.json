                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/authority/dashboard",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "authority", "dashboard"]
            }
          }
        }
      ]
    },
