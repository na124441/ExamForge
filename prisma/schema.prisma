// ==============================================================================
// ExamForge — Production Prisma Database Schema
// Datasource: PostgreSQL / SQLite (Configurable via DATABASE_URL)
// Generator: prisma-client-js
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// 1. User Account & Authentication
// ------------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  VENDOR_OWNER
  VENDOR_ADMIN
  EXAM_CONTROLLER
  CENTRE_OFFICER
  INVIGILATOR
  EVALUATOR
  AUDITOR
  CANDIDATE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id               String              @id @default(uuid())
  name             String
  email            String              @unique
  phone            String?             @unique
  passwordHash     String
  role             UserRole            @default(CANDIDATE)
  status           AccountStatus       @default(ACTIVE)
  institutionId   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  candidateProfile CandidateProfile?
  vendorMemberships VendorMembership[]
  evaluations      EvaluationMark[]
  incidentsReported IncidentReport[]   @relation("ReportedIncidents")
  auditLogs        AuditLog[]          @relation("UserAuditLogs")

  @@index([email])
  @@index([role])
}

// ------------------------------------------------------------------------------
// 2. Vendor Examination-as-a-Service (EaaS) Models
// ------------------------------------------------------------------------------

enum VendorStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  SUSPENDED
}

model VendorOrganization {
  id                   String             @id @default(uuid())
  name                 String
  legalName            String
  registrationNumber   String             @unique
  tenantSlug           String             @unique
  email                String
  googleOauthKey       String?
  dltSmsKey            String?
  paymentUpiId         String?
  paymentBankName      String?
  paymentAccountNumber String?
  paymentIfscCode      String?
  status               VendorStatus       @default(APPROVED)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  memberships          VendorMembership[]
  exams                Exam[]
  centreRequests       CentreRequest[]
  applications         ExamApplication[]

  @@index([tenantSlug])
}

model VendorMembership {
  id           String             @id @default(uuid())
  userId       String
  vendorId     String
  role         String             @default("VENDOR_ADMIN")
  createdAt    DateTime           @default(now())

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor       VendorOrganization @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
}

// ------------------------------------------------------------------------------
// 3. Candidate Lifecycle & Identity Verification Models
// ------------------------------------------------------------------------------

enum AadhaarVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
  MANUAL_REVIEW
}

model CandidateProfile {
  id                  String                    @id @default(uuid())
  userId              String                    @unique
  candidateStudentId  String                    @unique
  fullName            String
  email               String                    @unique
  phone               String                    @unique
  dob                 String?
  gender              String?
  category            String?
  guardianName        String?
  addressLine1        String?
  city                String?
  district            String?
  state               String?
  postalCode          String?
  latitude            Float?
  longitude           Float?
  aadhaarStatus       AadhaarVerificationStatus @default(UNVERIFIED)
  aadhaarNumberMasked String?
  photoMatchPercent   Float                     @default(0.0)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications        ExamApplication[]
  admitCards          AdmitCardRecord[]
  results             Result[]

  @@index([candidateStudentId])
}

model OTPRecord {
  id           String   @id @default(uuid())
  destination  String
  otpHash      String
  purpose      String
  attemptCount Int      @default(0)
  status       String   @default("PENDING")
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([destination, purpose])
}

// ------------------------------------------------------------------------------
// 4. Examination & Question Bank Engine
// ------------------------------------------------------------------------------

enum ExamStatus {
  DRAFT
  PUBLISHED
  APPLICATION_OPEN
  APPLICATION_CLOSED
  EXAM_ACTIVE
  EVALUATION_ACTIVE
  RESULT_PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  NUMERICAL
  SUBJECTIVE_ESSAY
  CODING
}

model Exam {
  id                  String             @id @default(uuid())
  code                String             @unique
  title               String
  description         String?
  vendorId            String
  totalMarks          Float
  passingMarks        Float
  durationMinutes     Int
  negativeMarking     Float              @default(0.0)
  applicationStart    DateTime
  applicationEnd      DateTime
  examDate            DateTime
  status              ExamStatus         @default(DRAFT)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  vendor              VendorOrganization @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  questions           Question[]
  paperSets           GeneratedPaperSet[]
  applications        ExamApplication[]
  results             Result[]

  @@index([code])
}

model Question {
  id               String             @id @default(uuid())
  examId           String
  subject          String
  topic            String
  difficulty       String             // EASY, MEDIUM, HARD
  type             QuestionType
  marks            Float
  encryptedContent String             // Ciphertext of question text + KaTeX formulas
  encryptedAnswer  String             // Ciphertext of solution key
  status           String             @default("APPROVED")
  createdAt        DateTime           @default(now())

  exam             Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  evaluations      EvaluationMark[]

  @@index([examId, subject])
}

model GeneratedPaperSet {
  id              String   @id @default(uuid())
  examId          String
  setId           String   // Set A, B, C, D
  questionOrder   String   // JSON list of question IDs
  optionOrderMap  String   // JSON option permutation map
  paperHash       String
  status          String   @default("LOCKED")
  createdAt       DateTime @default(now())

  exam            Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, setId])
}

// ------------------------------------------------------------------------------
// 5. Exam Centres & Geospatial Allocation Engine
// ------------------------------------------------------------------------------

model ExamCentre {
  id                String            @id @default(uuid())
  name              String
  code              String            @unique
  address           String
  city              String
  district          String
  state             String
  postalCode        String
  latitude          Float
  longitude         Float
  computerCapacity  Int
  cctvVerified      Boolean           @default(true)
  powerBackup       Boolean           @default(true)
  status            String            @default("APPROVED")
  createdAt         DateTime          @default(now())

  applications      ExamApplication[]
  admitCards        AdmitCardRecord[]

  @@index([city, district])
}

model CentreRequest {
  id              String             @id @default(uuid())
  vendorId        String
  city            String
  requiredCapacity Int
  status          String             @default("SUBMITTED")
  createdAt       DateTime           @default(now())

  vendor          VendorOrganization @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------------------
// 6. Exam Applications, Payments & Admit Cards
// ------------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model ExamApplication {
  id                String            @id @default(uuid())
  applicationNumber String            @unique
  examId            String
  candidateId       String
  vendorId          String?
  feeAmount         Float
  paymentStatus     PaymentStatus     @default(PENDING)
  paymentReference String?
  allocatedCenterId String?
  allocatedSlot     String?
  admitCardHash     String?
  status            String            @default("SUBMITTED")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  exam              Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  candidate         CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vendor            VendorOrganization? @relation(fields: [vendorId], references: [id])
  allocatedCenter   ExamCentre?       @relation(fields: [allocatedCenterId], references: [id])
  paymentOrders     PaymentOrder[]
  admitCard         AdmitCardRecord?

  @@index([applicationNumber])
}

model PaymentOrder {
  id             String          @id @default(uuid())
  applicationId  String
  amount         Float
  currency       String          @default("INR")
  provider       String          @default("RAZORPAY")
  transactionRef String          @unique
  status         PaymentStatus   @default(PENDING)
  createdAt      DateTime        @default(now())

  application    ExamApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AdmitCardRecord {
  id            String          @id @default(uuid())
  applicationId String          @unique
  candidateId   String
  examId        String
  centerId      String
  reportingTime String
  admitCardHash String
  signature     String
  status        String          @default("VALID")
  generatedAt   DateTime        @default(now())

  application   ExamApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  center        ExamCentre       @relation(fields: [centerId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------------------
// 7. Evaluation & Double-Blind Checking Engine
// ------------------------------------------------------------------------------

model EvaluationMark {
  id             String    @id @default(uuid())
  examId         String
  anonymousId    String
  evaluatorId    String
  questionId     String
  criteriaScores String    // JSON map of criterion -> marks
  totalMarks     Float
  notes          String?
  evaluationHash String
  status         String    @default("SUBMITTED")
  createdAt      DateTime  @default(now())

  evaluator      User      @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([anonymousId, questionId])
}

// ------------------------------------------------------------------------------
// 8. Result Publication Gate & Verifiable Certificates
// ------------------------------------------------------------------------------

model Result {
  id            String            @id @default(uuid())
  examId        String
  candidateId   String
  marksObtained Float
  maxMarks      Float
  status        String            @default("VERIFIED")
  resultHash    String
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())

  exam          Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  candidate     CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  certificates  ResultCertificate[]
}

model ResultCertificate {
  id             String   @id @default(uuid())
  resultId       String
  certificateHash String
  signature      String
  verificationUrl String
  status         String   @default("VALID")
  issuedAt       DateTime @default(now())

  result         Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------------------
// 9. Operational Audit & Incident Management
// ------------------------------------------------------------------------------

model IncidentReport {
  id           String   @id @default(uuid())
  examId       String
  centerId     String
  reportedById String
  incidentType String
  severity     String
  description  String
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())

  reportedBy   User     @relation("ReportedIncidents", fields: [reportedById], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  actorId      String
  action       String
  resourceType String
  resourceId   String
  payloadHash  String
  previousHash String
  currentHash  String
  createdAt    DateTime @default(now())

  actor        User     @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
}
